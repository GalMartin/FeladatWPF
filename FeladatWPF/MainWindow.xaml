<Window x:Class="FeladatWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FeladatWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="84" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="DolgozatTabla"
          Grid.Row="0"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          RowHeight="24"
          ColumnHeaderHeight="30"
          RowHeaderWidth="7"
          Background="WhiteSmoke">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Név"
                            Binding="{Binding Nev}"
                            Width="SizeToCells" />
                <DataGridTextColumn Header="Életkor"
                            Binding="{Binding Eletkor}"
                            Width="58" />
                <DataGridTextColumn Header="Pontszám"
                            Binding="{Binding Pontszam}"
                            Width="78" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
